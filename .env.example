# Скопируйте в .env на своём компьютере. Никогда не публикуйте заполненный .env.
# Строка подключения к ВАШЕЙ базе данных с поддержкой схемы prisma/schema.prisma.
# Получите её в панели выбранного провайдера. Для Vercel используйте соединение с пулом.
DATABASE_URL=""

# Секрет подписи сессий и краткосрочных заданий PDF (не менее 32 случайных байтов).
# Создайте локально: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Необязательное совместимое имя того же секрета. Если заполняете оба, значения должны совпадать.
NEXTAUTH_SECRET=""

# Базовый адрес сайта. Локально оставьте как ниже, в Vercel укажите адрес своего проекта.
NEXTAUTH_URL="http://localhost:3000"

# Только для ручного первоначального запуска yarn db:seed; не нужны в Vercel.
# Если OWNER_PASSWORD пуст, аккаунт не создаётся; исходные описания клеток всё равно добавляются.
OWNER_EMAIL="admin@mail.ru"
OWNER_NAME="Владелец"
OWNER_PASSWORD=""
# true — явно выдать права owner существующему OWNER_EMAIL; пароль при этом НЕ меняется.
PROMOTE_GAME_OWNER="false"

# NODE_ENV и PORT задаются средой запуска; вручную в Vercel их не добавляйте.
# AUTH_SMOKE_BASE — необязательный адрес сайта для scripts/auth-smoke.mjs (по умолчанию localhost:3000).
# VERIFY_BROWSER=true — необязательная браузерная часть старых локальных проверок.
# Они не требуются для сборки или работы сайта.
# ABACUSAI_API_KEY был нужен исходному PDF-сервису; в автономной версии удалён и НЕ нужен.
# NEXT_DIST_DIR и NEXT_OUTPUT_MODE были настройками исходного хостинга; здесь не используются.
